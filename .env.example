# AgriShield AI — environment configuration
# Copy to backend/.env and fill in real values. Never commit .env files.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/agrishield
MONGO_URI=mongodb://127.0.0.1:27017/agrishield

# Security
JWT_SECRET=change_this_to_a_long_random_string

# AI service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Weather — OpenWeatherMap API key (https://openweathermap.org/api)
# If blank, the app falls back to Open-Meteo (free, no key needed).
WEATHER_API_KEY=
WEATHER_API_BASE=https://api.openweathermap.org/data/2.5

# Market data — data.gov.in API key + resource id (AGMARKNET mandi prices)
# If blank, a clearly-labelled reference dataset is served.
MARKET_API_KEY=
MARKET_RESOURCE_ID=

# Satellite imagery API key (optional, for future Sentinel/landsat integration)
MAP_API_KEY=
